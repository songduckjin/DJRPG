{
  "name": "djrpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit && node scripts/verify-item-art.mjs",
    "build": "tsc --noEmit && node scripts/verify-item-art.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "dev:cf": "wrangler pages dev",
    "deploy:cf": "pnpm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.0.0"
  }
}
